# ------------------------------------------------------------------
# INBOX EXORCIST — environment configuration
# Copy to .env and adjust. NEVER commit a real .env with secrets.
# ------------------------------------------------------------------

# Port the server listens on (Render sets this automatically).
PORT=3000

# --- Gmail OAuth (user brings their own FREE Google Cloud credentials) ---
# 5-minute setup — full steps in README.md:
#  1. https://console.cloud.google.com → new project → enable "Gmail API"
#  2. APIs & Services → Credentials → Create Credentials → OAuth client ID
#     → Web application → add Authorized redirect URI (see below)
#  3. Paste the client ID + secret here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MUST match an "Authorized redirect URI" in your Google Cloud OAuth client.
# Local dev:  http://localhost:3000/auth/callback
# Render:      https://YOUR-SERVICE.onrender.com/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Force demo mode (mock vendors, simulated nukes) even if OAuth is set.
# Handy for screenshots / trying the UI with zero setup.
DEMO_MODE=0

# Comma-separated allowed frontend origins, e.g.
# FRONTEND_URL=https://inbox-exorcist.onrender.com
# Leave empty to allow all origins (fine for local dev).
FRONTEND_URL=

# Per-IP rate limits.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Trust proxy hops for correct client IPs behind Render/Heroku-style hosts.
TRUST_PROXY=1

# Set to "production" on Render (enables Secure cookies).
NODE_ENV=development
